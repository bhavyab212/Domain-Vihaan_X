# ==============================================================================
# Domain-Vihaan_X — Root Environment Blueprint (.env.example)
# DO NOT STORE REAL SECRETS IN THIS FILE.
# Copy to `.env` for local configuration.
# ==============================================================================

# --- Global Operating Parameters ---
APP_ENV=development
APP_NAME=Domain-Vihaan_X
DEMO_MODE=true

# --- Backend Server Configuration ---
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./domain_vihaan_x.db

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Scanner Orchestrator Configuration ---
SCANNER_TIMEOUT=60
SCANNER_ISOLATION_MODE=subprocess
ALLOWED_TARGET_ROOT=./data/demo/mock_saas

# --- Optional HexStrike-AI Integration ---
HEXSTRIKE_ENABLED=false
HEXSTRIKE_BASE_URL=http://127.0.0.1:8888
HEXSTRIKE_TOKEN=

# --- Optional AI Analysis Engine (Falls back to embedded rule engine if blank) ---
AI_PROVIDER=none
AI_API_KEY=
