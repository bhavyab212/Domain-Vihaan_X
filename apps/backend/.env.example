# apps/backend/.env.example
# Backend environment variable blueprint

APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Operating Mode: DEMO_MODE or LIVE_ASSESSMENT_MODE
DEFAULT_OPERATING_MODE=DEMO_MODE

# Database
DATABASE_URL=sqlite:///./data/runtime/vihaan_x.db

# Security & Isolation
ALLOWED_TARGET_DOMAINS=["localhost","127.0.0.1","mock-saas.local"]
ISOLATION_SANDBOX_DIR=./data/runtime/sandbox

# Optional External Integrations (Fallback to local rule engine if missing)
GEMINI_API_KEY=
HEXSTRIKE_MCP_URL=
