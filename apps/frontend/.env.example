# ==============================================================================
# Domain-Vihaan_X - Frontend Environment Configuration (.env.example)
# Copy to `.env.local` for local overrides. Never put secrets in VITE_* values:
# everything prefixed VITE_ is embedded in the public client bundle.
# ==============================================================================

# Control Plane API base URL. Source of truth: contracts/openapi/openapi.yaml `servers[0].url`.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Initial data source for the five views.
#   preview = local SIMULATED_DEMO fixtures (src/mocks), clearly labelled in the UI
#   api     = live requests to VITE_API_BASE_URL (errors and empty states are shown as-is)
# Users can switch at runtime from the command bar; the choice is kept in localStorage.
VITE_DATA_SOURCE=preview
