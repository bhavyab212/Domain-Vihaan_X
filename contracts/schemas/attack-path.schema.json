{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domain-vihaan-x.local/schemas/attack-path.schema.json",
  "title": "AttackPath",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "severity",
    "confidenceScore",
    "isSimulated",
    "entryPointAssetId",
    "crownJewelAssetId",
    "steps",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "isSimulated": { "type": "boolean" },
    "entryPointAssetId": { "type": "string" },
    "crownJewelAssetId": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stepNumber", "assetId", "description", "technique"],
        "properties": {
          "stepNumber": { "type": "integer" },
          "assetId": { "type": "string" },
          "findingId": { "type": "string" },
          "description": { "type": "string" },
          "technique": { "type": "string" },
          "mitreTactic": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "MITIGATED"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
